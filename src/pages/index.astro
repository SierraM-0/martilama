---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getSortedPosts } from '../utils/posts';
import portrait from '../assets/portrait.png';

const posts = (await getSortedPosts()).slice(0, 5);
---
<BaseLayout>
  <section class="intro reveal">
    <Image src={portrait} alt="A photo of marti" width={120} height={120} class="portrait" loading="eager" fetchpriority="high" />
    <div>
      <h1>Hello 👋🏻</h1>
      <p>
        I'm Marti — a product specialist based in Tallinn. This is where I write
        about life in general and whatever small opinions I happen to be holding.
      </p>
    </div>
  </section>
  <p class="hero-meta reveal reveal-2">Tallinn, Estonia · <time id="localtime">—</time> local</p>

  <h2 class="reveal reveal-3">Recent posts</h2>
  {posts.map((post) => <PostCard post={post} />)}
</BaseLayout>

<script>
  const fmt = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Tallinn',
  });
  let timer: ReturnType<typeof setTimeout> | undefined;

  // Update exactly on each minute boundary so the shown time never lags the
  // real clock, instead of polling on a fixed interval.
  function tick() {
    const el = document.getElementById('localtime');
    if (!el) return; // navigated away from home — stop the chain
    el.textContent = fmt.format(new Date());
    const now = new Date();
    const msToNextMinute = (60 - now.getSeconds()) * 1000 - now.getMilliseconds();
    clearTimeout(timer);
    timer = setTimeout(tick, msToNextMinute + 50);
  }

  function initClock() {
    clearTimeout(timer);
    tick();
  }

  // Runs on first load and after every View Transitions navigation.
  initClock();
  document.addEventListener('astro:page-load', initClock);
</script>
